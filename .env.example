# =============================================================================
# Apigene — environment configuration
# =============================================================================
#
#   cp .env.example .env
#   Bundle:   ./apigene setup
#   Registry: ./apigene setup --pull
#
# Public URL — pick one mode:
#
#   Local (default): set APIGENE_PORT only → http://localhost:$APIGENE_PORT
#
#   Custom domain / LAN IP / HTTPS: set NEXT_PUBLIC_SERVER_BASE_URL to the URL
#   users open in the browser (ALLOWED_ORIGINS follows automatically).
#
# MongoDB and Redis are included in this stack. Connection settings for those
# services are applied automatically — you usually do not need to change MONGO_DB_URL
# or REDIS_* unless you use external databases.
# =============================================================================

# -----------------------------------------------------------------------------
# Container images
# -----------------------------------------------------------------------------
#
# Registry prefix, including the trailing slash. ./apigene adds a missing slash.
# Leave the value empty to use images already on this machine (name:tag).
#   public.ecr.aws/apigene/  →  public.ecr.aws/apigene/apigene-backend:<tag>
#   (empty)                  →  apigene-backend:<tag>
#   localhost:5000/          →  localhost:5000/apigene-backend:<tag>
APIGENE_IMAGE_REGISTRY=public.ecr.aws/apigene/

# Default tag for every Apigene image. Pin a version here for production.
APIGENE_IMAGE_TAG=latest

# Optional: a different tag for one service. backend and backend-worker share a tag.
# Example: backend 6.0.0, copilot / mcp-gw / nginx stay on APIGENE_IMAGE_TAG.
# APIGENE_BACKEND_IMAGE_TAG=6.0.0
# APIGENE_COPILOT_IMAGE_TAG=
# APIGENE_MCP_GW_IMAGE_TAG=
# APIGENE_NGINX_IMAGE_TAG=

# Optional: image name when it differs from the published name.
# APIGENE_BACKEND_IMAGE_NAME=apigene-backend
# APIGENE_COPILOT_IMAGE_NAME=apigene-copilot
# APIGENE_MCP_GW_IMAGE_NAME=apigene-mcp-gw
# APIGENE_NGINX_IMAGE_NAME=apigene-nginx

# Public images are linux/amd64. Set linux/arm64 for images built on Apple Silicon.
# APIGENE_IMAGE_PLATFORM=linux/arm64

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------

# --- Mode A: local dev (default) ---
APIGENE_PORT=8080

# --- Mode B: custom public URL (uncomment and set instead of relying on localhost) ---
# NEXT_PUBLIC_SERVER_BASE_URL=https://apigene.example.com
# NEXT_PUBLIC_SERVER_BASE_URL=http://192.168.1.100:8080
# ALLOWED_ORIGINS=https://apigene.example.com,http://localhost:8080
# Copilot calls APIGENE_INTERNAL_BASE_URL (http://localhost:$APIGENE_PORT) from
# inside the stack. Do not point that at the public address.


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Logical environment name — use a unique value per deployment to isolate data.
DATABASE_ENV=local

# Deployment mode (default SaaS). OnPrem enables 30-day trial + paste-license upgrade.
# DEPLOYMENT_TYPE=OnPrem
# LICENSE_PUBLIC_KEY=  # PEM or base64:… public key (OnPrem only; algorithm defaults to RS256)

# Optional tenant identifier (defaults to "local" in docker-compose.yml).
# TENANT_NAME=local

# Host port for MongoDB (default 27017). Change if you already run MongoDB locally.
# MONGO_HOST_PORT=27018

# -----------------------------------------------------------------------------
# Authentication (required for self-hosted / docker-compose)
# -----------------------------------------------------------------------------

# Default auth for this stack. Without this, copilot and mcp-gw fall back to Clerk
# and will fail unless you configure Clerk keys below.
NEXT_PUBLIC_AUTH_PROVIDER=apigene

# Secret used to sign Apigene session tokens. Change this in production.
AUTH_APIGENE_SECRET_KEY=YOUR_SECRET_KEY

# --- Keycloak (OL Hub) ---
# NEXT_PUBLIC_AUTH_PROVIDER=keycloak
# KEYCLOAK_ISSUER=https://keycloak.example.com/auth/realms/ol-hub
# KEYCLOAK_CLIENT_ID=hub-spa
# KEYCLOAK_CLIENT_SECRET=            # only for a confidential client
# KEYCLOAK_SCOPES=openid email profile
# NEXT_PUBLIC_KEYCLOAK_REDIRECT_URI=http://localhost:8080/client-api/auth/keycloak/callback
# AUTH_KEYCLOAK_ISSUER=https://keycloak.example.com/auth/realms/ol-hub
# AUTH_KEYCLOAK_ALLOWED_CLIENTS=hub-spa

# -----------------------------------------------------------------------------
# Cache and background jobs
# -----------------------------------------------------------------------------

CACHE_ENABLED=True

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_ENV=local

# Browser log viewer at /log-viewer. Off by default. When true, ./apigene also
# writes each service's stdout to a shared volume that Copilot reads.
APIGENE_LOG_VIEWER=true
