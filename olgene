#!/usr/bin/env bash
set -euo pipefail

APIGENE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$APIGENE_ROOT"

# shellcheck disable=SC1091
source "$APIGENE_ROOT/lib/ui.sh"
# shellcheck disable=SC1091
source "$APIGENE_ROOT/lib/runtime.sh"
# shellcheck disable=SC1091
source "$APIGENE_ROOT/lib/cmd_setup.sh"
# shellcheck disable=SC1091
source "$APIGENE_ROOT/lib/cmd_start.sh"
# shellcheck disable=SC1091
source "$APIGENE_ROOT/lib/cmd_stop.sh"
# shellcheck disable=SC1091
source "$APIGENE_ROOT/lib/cmd_test.sh"
# shellcheck disable=SC1091
source "$APIGENE_ROOT/lib/cmd_logs.sh"
# shellcheck disable=SC1091
source "$APIGENE_ROOT/lib/cmd_images.sh"
# shellcheck disable=SC1091
source "$APIGENE_ROOT/lib/cmd_package.sh"

olgene_usage() {
  olgene_banner "OL-Gene CLI"
  cat <<EOF
Usage: ./olgene <command> [options]

Commands:
  setup [--pull]     Load olgene-images.tar.gz and start. --pull uses the registry
  start [--pull]     Start all services
  stop [--volumes]   Stop services (optionally delete Mongo data)
  test               Run health checks on the full stack
  logs [services]    Tail colored logs (add --raw for plain output)
  images save        Pull the stack images and write olgene-images.tar.gz
  images load        Load olgene-images.tar.gz into Docker or Podman
  images push        Push loaded images to a private registry
  package <tag>      Build ol-gene-<tag>-linux-amd64.tar.gz for a release

Examples:
  ./olgene setup
  ./olgene setup --pull
  ./olgene start
  ./olgene start --pull
  ./olgene test
  ./olgene stop
  ./olgene stop --volumes
  ./olgene logs backend
  ./olgene images save
  ./olgene images load
  ./olgene package 5.5.1

Options:
  -h, --help         Show help for a command or this overview
EOF
}

main() {
  local cmd="${1:-}"

  case "$cmd" in
    ""|help|-h|--help)
      olgene_usage
      ;;
    setup)
      shift
      cmd_setup "$@"
      ;;
    start)
      shift
      cmd_start "$@"
      ;;
    stop)
      shift
      cmd_stop "$@"
      ;;
    test)
      shift
      set +e
      cmd_test "$@"
      exit $?
      ;;
    logs)
      shift
      cmd_logs "$@"
      ;;
    images)
      shift
      cmd_images "$@"
      ;;
    package)
      shift
      cmd_package "$@"
      ;;
    *)
      olgene_err "Unknown command: $cmd"
      echo ""
      olgene_info "Run ${C_BOLD}./olgene --help${C_RESET} to see available commands."
      exit 1
      ;;
  esac
}

main "$@"
